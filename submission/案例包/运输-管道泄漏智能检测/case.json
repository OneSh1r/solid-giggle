        {
          "name": "阀门误报",
          "why": "调阀和启停泵引起的流量变化未被工况标签剔除。"
        },
        {
          "name": "虚假精确定位",
          "why": "模型给出单点公里数却没有区间，导致巡线资源被错误调度。"
        }
      ]
