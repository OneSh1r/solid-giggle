          "trap": "把所有预警都当事故标签会污染训练，应区分确认与未确认。",
          "visual": "<svg viewBox=\"0 0 620 82\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"分级复核与回填步骤示意\">\n    <rect x=\"2\" y=\"8\" width=\"616\" height=\"66\" rx=\"9\" fill=\"#f8f7f2\" stroke=\"#e4e0d5\"/>\n    <text x=\"17\" y=\"28\" font-size=\"9\" font-family=\"monospace\" fill=\"#7d898c\">STEP 04 · 闭环</text>\n    <rect x=\"16\" y=\"38\" width=\"126\" height=\"24\" rx=\"5\" fill=\"#fff\" stroke=\"#e4e0d5\"/>\n      <text x=\"79\" y=\"54\" text-anchor=\"middle\" font-size=\"9\" fill=\"#213033\">预警</text>\n      <path d=\"M143 50h27\" stroke=\"#b46d3b\" stroke-width=\"1\"/><rect x=\"182\" y=\"38\" width=\"126\" height=\"24\" rx=\"5\" fill=\"#fff\" stroke=\"#e4e0d5\"/>\n      <text x=\"245\" y=\"54\" text-anchor=\"middle\" font-size=\"9\" fill=\"#213033\">复核</text>\n      <path d=\"M309 50h27\" stroke=\"#b46d3b\" stroke-width=\"1\"/><rect x=\"348\" y=\"38\" width=\"126\" height=\"24\" rx=\"5\" fill=\"#fff\" stroke=\"#e4e0d5\"/>\n      <text x=\"411\" y=\"54\" text-anchor=\"middle\" font-size=\"9\" fill=\"#213033\">事件回填</text>\n      \n    <rect x=\"523\" y=\"37\" width=\"80\" height=\"27\" rx=\"6\" fill=\"#e7f2ed\" stroke=\"#a8cfc2\"/>\n    <text x=\"563\" y=\"54\" text-anchor=\"middle\" font-size=\"8.6\" font-family=\"monospace\" fill=\"#2f7d6b\">误报 ≤2/班</text>\n  </svg>"
        }
